data_workers: 10
name: p9_determinism_B-wellp-delta-Isotr[Space-Adapt-]-AdamW-0.0002
finetune: false
automatic_setup: true
seed: 0
trainer:
  _target_: walrus.trainer.Trainer
  max_epoch: 2
